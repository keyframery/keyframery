{
  "name": "keyframery",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "registry:build": "pnpm -C registry build && node registry/scripts/check.mjs",
    "registry:serve": "node registry/scripts/serve.mjs",
    "fixtures:create": "node fixtures/create.mjs",
    "fixtures:sync": "node fixtures/sync.mjs",
    "fixtures:build": "node fixtures/build.mjs",
    "refresh": "pnpm registry:build && pnpm fixtures:sync && node fixtures/build.mjs",
    "typecheck": "pnpm -C registry typecheck",
    "test:unit": "pnpm -C tests unit",
    "test:e2e": "pnpm -C tests e2e",
    "check:vite": "node fixtures/vite-check.mjs",
    "check:monorepo": "node fixtures/monorepo-check.mjs",
    "drift": "node scripts/drift.mjs",
    "site:sync": "pnpm registry:build && pnpm -C apps/web sync",
    "site:build": "pnpm registry:build && pnpm -C apps/web build",
    "site:start": "pnpm -C apps/web start -p 4500",
    "test:site": "pnpm -C tests exec playwright test -c playwright.site.config.ts",
    "check": "sh scripts/check.sh",
    "check:site": "sh scripts/check.sh site",
    "indexnow": "node scripts/indexnow.mjs"
  }
}
