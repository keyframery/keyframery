{
  "name": "keyframery",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 4610 --strictPort",
    "build": "node scripts/stamp-dates.mjs && node scripts/build-registry.mjs && node scripts/build-docs.mjs && next build",
    "lab:build": "tsc --noEmit && vite build",
    "registry": "node scripts/build-registry.mjs",
    "site:dev": "node scripts/build-registry.mjs && node scripts/build-docs.mjs && next dev -p 4640",
    "start": "next start",
    "docs": "node scripts/build-docs.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.next.json && tsc --noEmit -p tsconfig.registry.json && node --test scripts/tests/*.test.mjs && node scripts/check-sdk-contracts.mjs --styled && node scripts/check-customization.mjs && node scripts/check-registry.mjs",
    "check:browser": "node scripts/check-demos.cjs",
    "check:weight": "node scripts/check-page-weight.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@neondatabase/serverless": "^1.2.1",
    "@types/mdx": "^2.0.14",
    "@ui-sdk/core": "0.1.0-beta.9",
    "@ui-sdk/react": "0.1.0-beta.9",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.16.2",
    "fumadocs-mdx": "15.4.6",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.16.2",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "1.63.0",
    "shadcn": "4.21.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
