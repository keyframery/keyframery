{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "preserveSymlinks": false,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "vue": [
        "./node_modules/vue"
      ],
      "@ui-sdk/vue/*": [
        "./node_modules/@ui-sdk/vue/dist/*.d.ts"
      ],
      "@ui-sdk/vue": [
        "./node_modules/@ui-sdk/vue"
      ],
      "@ui-sdk/core": [
        "./node_modules/@ui-sdk/core"
      ],
      "@ui-sdk/core/*": [
        "./node_modules/@ui-sdk/core/dist/*.d.ts"
      ],
      "tailwind-merge": [
        "./node_modules/tailwind-merge"
      ]
    }
  },
  "include": [
    "src/main.ts",
    "src/App.vue",
    "src/demos/**/*.vue",
    "src/lib/*.ts",
    "env.d.ts"
  ]
}